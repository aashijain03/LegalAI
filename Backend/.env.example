# Hugging Face API key used for LLM calls (required)
HF_API_KEY=

# Secret used to sign JWTs (required) — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on (optional, defaults to 3001)
PORT=3001

# Frontend origin allowed to call this API. Required in production;
# defaults to http://localhost:5173 in development.
CORS_ORIGIN=http://localhost:5173

# Optional: override the primary/fallback Hugging Face models
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_FALLBACK_MODELS=Qwen/Qwen2.5-Coder-32B-Instruct
